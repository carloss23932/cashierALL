{
  "name": "cro-p",
  "productName": "CRO P",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "npx vite --port 8080 --strictPort",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:server": "tsx watch index.cjs",
    "dev:electron": "npx wait-on http://localhost:8080 && electron .",
    "dev:desktop": "npx concurrently -k \"npm:dev\" \"npm:dev:electron\"",
    "print:test": "node scripts/send-raw-print.cjs",
    "prebuild:desktop": "npx prisma db push --accept-data-loss && npx prisma db seed",
    "build:desktop": "npm run prebuild:desktop && npm run prisma:generate && npm run build && electron-builder",
    "publish:desktop": "npm run prebuild:desktop && npm run prisma:generate && npm run build && electron-builder --publish always",
    "dist:win": "electron-builder --win --x64 --ia32",
    "postinstall": "electron-builder install-app-deps",
    "prisma:generate": "npx prisma generate",
    "check-db": "node -e \"console.log('DB exists:', require('fs').existsSync('prisma/dev.db'))\"",
    "reinstall": "node clean.js && npm install"
  },
  "prisma": {
    "seed": "node -e \"import('tsx').then(m=>m.default(['prisma/seed.ts']))\""
  },
  "build": {
    "appId": "com.pos.system",
    "productName": "CRO P",
    "asar": false,
    "directories": {
      "output": "dist_electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "prisma/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": "app/node_modules/.prisma"
      },
      "prisma/schema.prisma",
      "prisma/dev.db"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "electron/icons/icon.ico",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "electron/icons/icon.ico",
      "uninstallerIcon": "electron/icons/icon.ico",
      "installerHeaderIcon": "electron/icons/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "carloss23932",
      "repo": "cashier-updata",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.22.0",
    "@prisma/debug": "7.2.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tanstack/react-query": "^5.56.2",
    "arabic-reshaper": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dbffile": "^1.12.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.3.0",
    "embla-carousel-react": "^8.3.0",
    "express": "^5.1.0",
    "iconv-lite": "^0.6.3",
    "input-otp": "^1.2.4",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "usb": "^2.12.1",
    "vaul": "^0.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.5.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "lovable-tagger": "^1.1.7",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.21",
    "wait-on": "^7.2.0"
  },
  "description": "نظام نقاط البيع",
  "main": "electron/main.cjs",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
